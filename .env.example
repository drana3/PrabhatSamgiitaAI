DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prabhatai
# Production: Neon pooled URL with sslmode=require (store in secrets, never commit).
# Direct (non-pooler) URL is only for Alembic / pg_restore.
FAISS_INDEX_DIR=./data/generated/faiss
# Production: private Azure Blob zip SAS URL (Container App / GitHub secret). Never commit.
FAISS_INDEX_URL=
APP_ENV=development
APP_NAME=Prabhat Samgiita AI
APP_VERSION=0.1.0
API_CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,acceptance
MAX_REQUEST_BYTES=1048576
LOG_LEVEL=INFO
ADMIN_API_KEY_HASH=
SCHEDULER_ENABLED=false
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=500
# Keep API in-process catalog memory synced with Postgres (polling).
CATALOG_POLL_ENABLED=true
CATALOG_POLL_INTERVAL_SECONDS=30
CATALOG_POLL_INITIAL_DELAY_SECONDS=5
CATALOG_POLL_LOOKBACK_MINUTES=30
CATALOG_POLL_OVERLAP_SECONDS=90
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview
CONTENT_CACHE_DIR=./data/generated/cache
CONTENT_SOURCE_URL=https://prabhatasamgiita.net
PUBLIC_SITE_URL=http://localhost:3000
ACS_EMAIL_ENABLED=false
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_FROM=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
MEMBER_PROXY_KEY=replace-with-a-long-random-server-only-value
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-side token exchange (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Optional server-only; used by /api/auth/google/token when exchanging the OAuth code
GOOGLE_CLIENT_SECRET=
# Cloud Translation API key (Basic NMT). Stay inside free tier; over budget → LLM.
# Enable Cloud Translation API in GCP and create an API key restricted to that API.
# KEEP GOOGLE_TRANSLATE_ALLOW_PAID=false so billing stays ₹0 (hard-capped at 450k chars/mo).
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENABLED=true
GOOGLE_TRANSLATE_MONTHLY_CHAR_LIMIT=400000
GOOGLE_TRANSLATE_ALLOW_PAID=false
GOOGLE_TRANSLATE_QUOTA_PATH=./data/generated/google_translate_quota.json
NEXT_PUBLIC_FACEBOOK_APP_ID=
# Phase 2: set to true when Facebook OAuth is ready
NEXT_PUBLIC_FACEBOOK_AUTH_ENABLED=false
DEFAULT_ADMIN_EMAILS=
PROTECTED_ADMIN_EMAILS=

# Kiirtan / Bhajan recordings (docs/kiirtan-publishing.md). Local disk in dev; R2 (S3-compatible) once the bucket exists.
RECORDING_STORAGE_BACKEND=local
RECORDING_LOCAL_DIR=./data/generated/recordings
RECORDING_MAX_BYTES=62914560
# Longest recording accepted, in seconds (docs/upload-validation.md). 14400 = 4 hours.
RECORDING_MAX_DURATION_SECONDS=14400
RECORDING_SIGNING_SECRET=
RECORDING_TERMS_VERSION=2026-11
RECORDING_FLAG_THRESHOLD=3
# At most this many recordings per member in 24 hours (docs/kiirtan-publishing.md, Duplicates)
RECORDING_UPLOADS_PER_DAY=20
# Chromaprint binary for the similar-sound warning; empty or missing = the warning is skipped
RECORDING_FPCALC_PATH=fpcalc
# RECORDING_STORAGE_BACKEND=s3 needs all of these, RECORDING_PUBLIC_BASE_URL included (never commit values):
RECORDING_S3_ENDPOINT=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=auto
RECORDING_S3_ACCESS_KEY_ID=
RECORDING_S3_SECRET_ACCESS_KEY=
RECORDING_PUBLIC_BASE_URL=

# Server push for replies to comments (apps/mobile/docs/comment-replies.md). Off unless true.
PUSH_ENABLED=false
# Optional Expo access token (bearer key for the Expo push API).
EXPO_ACCESS_TOKEN=

# --- Member sign-in with signed tokens (docs/security-member-auth.md). Generate each secret yourself, never commit one.
# Signs the one-hour access tokens (32+ random characters). Rotating it signs everybody out.
MEMBER_SESSION_SECRET=
# Old secret, accepted for checking only while you rotate.
MEMBER_SESSION_SECRET_PREVIOUS=
MEMBER_ACCESS_TTL_SECONDS=3600
MEMBER_REFRESH_TTL_DAYS=30
# Key only the website server holds (set the same value on the API and on the website). Never put it in an app.
WEB_PROXY_KEY=
# Website only: how many platform proxies sit in front of the website server (1-5, default 1). Used to read the
# visitor's address from X-Forwarded-For counted from the right; the visitor's own entries are never trusted.
WEB_TRUSTED_PROXY_HOPS=1
# Old app versions: shared key + self-made identity. true = still accepted as a plain member (migration).
ALLOW_LEGACY_MEMBER_PRINCIPAL=true
# Last day (YYYY-MM-DD) the old shared key still works; the day after it is refused, like false above.
# Empty = no end date.
# Recommended 2027-01-31, after the forced update (docs/decisions-security.md).
LEGACY_PRINCIPAL_UNTIL=
# Where rights holders write; used in the takedown letters (docs/takedown-process.md).
COPYRIGHT_CONTACT_EMAIL=info@anandamarga.org
# Emergency only: true lets the shared key act as admin/team again. Keep false.
LEGACY_PRINCIPAL_ADMIN=false
# Who may vouch for a sign-in (comma lists of OUR OWN client ids; public ids, not secrets).
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_BUNDLE_IDS=net.prabhatasamgiita.ai
# Revoke Sign in with Apple when an Apple member deletes the account (docs/apple-token-revocation.md).
# Without all three the revocation is skipped (logged); deletion still works. APPLE_PRIVATE_KEY is a SECRET:
# the .p8 file contents, one line with \n for the line breaks. Never commit a real value.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Sign-up age tick ("I'm 16 or older", docs/age-confirmation.md). false = a request without the field (an old app
# build) is still accepted; an explicit false is always refused. Set true once old builds are gone.
REQUIRE_AGE_CONFIRMATION=false
AZURE_CLIENT_IDS=
# Microsoft tenants whose e-mail addresses count as verified (comma list of tenant ids).
MEMBER_TRUSTED_MS_TENANTS=
# (Facebook sign-in was removed on 2026-11-09; see docs/sign-in-setup.md)
# Recording links are signed with RECORDING_SIGNING_SECRET (or the session secret). true re-allows the shared key.
RECORDING_SIGNING_ALLOW_PROXY_KEY=false

# --- YouTube Data API: "is this broadcast live right now" (docs/broadcasts.md). SECRET: environment only.
# Empty = the old behaviour, a broadcast is "on" by the organizer's clock. YouTube Data API v3 key, restricted to that API.
YOUTUBE_API_KEY=
YOUTUBE_STATUS_ENABLED=true
YOUTUBE_STATUS_TTL_SECONDS=60
YOUTUBE_DAILY_REQUEST_LIMIT=3000

# --- Request limiter (docs/rate-limits.md)
RATE_LIMIT_ENABLED=true
# database (shared by all instances) or memory (one process)
RATE_LIMIT_BACKEND=database
RATE_LIMIT_PEPPER=
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# --- Store reviewer account (docs/store-review-account.md). OFF unless STORE_REVIEWER_ENABLED=true.
# One ordinary member for Apple / Google reviewers to sign in with. SECRET: the password lives only in the
# environment of the running API (Azure secret). Min 12 characters. Switch off after the review.
STORE_REVIEWER_ENABLED=false
STORE_REVIEWER_EMAIL=
STORE_REVIEWER_PASSWORD=

# --- Virus scan of uploaded recordings (docs/upload-validation.md). auto = scan if ClamAV is there, log and go on
# if not; required = refuse uploads (503) when no scanner answers; off = never scan.
RECORDING_VIRUS_SCAN=auto
# RECORDING_CLAMSCAN_PATH=/usr/bin/clamscan   (default: found on PATH)
# CLAMD_HOST=  CLAMD_PORT=3310                (a clamd service, instead of the clamscan program)
# RECORDING_VIRUS_SCAN_TIMEOUT_SECONDS=60

# --- Crash reports (docs/observability.md). Off while SENTRY_DSN is empty. The DSN is an address, not a password,
# but it still comes from the environment and is not written in the repository.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Backups (docs/backups.md; infra/backup). Used by the backup scripts and the manual backup workflow, not by the API.
# BACKUP_DATABASE_URL=   direct (not pooled) Postgres address, a read-only user is best
# BACKUP_AGE_RECIPIENT=  the PUBLIC age key (age1...); keep the private key offline
# BACKUP_REMOTE=         rclone destination, for example backup:prabhat-backups/db
# BACKUP_RETENTION_DAYS=35
