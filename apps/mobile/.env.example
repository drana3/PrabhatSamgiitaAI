# Copy to `.env` for local Expo. Never commit real secrets.

# Live API (defaults to production ACA in app.config.js when unset)
EXPO_PUBLIC_API_BASE_URL=https://prabhatai-api.bluemeadow-9418d5fc.centralindia.azurecontainerapps.io

# Website origin for share links
EXPO_PUBLIC_WEB_BASE_URL=https://prabhatai-web.bluemeadow-9418d5fc.centralindia.azurecontainerapps.io

# Same MEMBER_PROXY_KEY the website uses for /members/* from native
EXPO_PUBLIC_MEMBER_PROXY_KEY=

# Entra app registration (prabhatai-members). Redirect: prabhatai://auth
# Google Cloud: add prabhatai://auth/google as an authorized redirect URI on your OAuth client.
# OAuth (Microsoft/Google) does not work in Expo Go — use `npm run android` for a dev build.
EXPO_PUBLIC_AZURE_CLIENT_ID=
EXPO_PUBLIC_AZURE_TENANT_ID=common

# Google OAuth (Web client ID works for Expo dev; add native clients for store builds)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
