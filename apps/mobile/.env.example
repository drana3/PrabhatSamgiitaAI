# Copy to `.env` for local Expo / local release builds. Never commit real secrets.

# Live API (defaults to production ACA in app.json / app.config.js when unset)
EXPO_PUBLIC_API_BASE_URL=https://prabhatai-api.bluemeadow-9418d5fc.centralindia.azurecontainerapps.io

# Website origin for share links
EXPO_PUBLIC_WEB_BASE_URL=https://prabhatai-web.bluemeadow-9418d5fc.centralindia.azurecontainerapps.io

# Same MEMBER_PROXY_KEY the website uses for /members/* from native (required for local release build)
EXPO_PUBLIC_MEMBER_PROXY_KEY=

# Entra app registration (prabhatai-members). Redirect: prabhatai://auth
# OAuth (Microsoft/Google) does not work in Expo Go — use `npm run ios` for a dev build.
EXPO_PUBLIC_AZURE_CLIENT_ID=14af4263-42b8-41fb-aac8-e730051a6864
EXPO_PUBLIC_AZURE_TENANT_ID=22cd8762-00e6-4945-850c-7b6ab1798844

# Google sign-in on mobile uses native Google Sign-In (not the browser flow).
# Web client (same as website NEXT_PUBLIC_GOOGLE_CLIENT_ID) is required on Android and iOS.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=495992354696-e0gs1mfnndgh9d38nkmp211f43im1h9q.apps.googleusercontent.com

# iOS OAuth client — Google Cloud → Create credentials → OAuth client ID → iOS
# Bundle ID: net.prabhatasamgiita.ai (no redirect URI field on iOS clients)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=495992354696-l5ddf29pefc5ke9f1t8osi9dch0qckrs.apps.googleusercontent.com

# Android OAuth client — Google Cloud → Create credentials → OAuth client ID → Android
# Package: net.prabhatasamgiita.ai
# SHA-1: run `cd apps/mobile/android && ./gradlew signingReport` and copy debug SHA-1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=495992354696-bg5emq0rv8hv4bqgk8uanvi2vkj34alv.apps.googleusercontent.com
