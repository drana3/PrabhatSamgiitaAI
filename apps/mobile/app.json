{
  "expo": {
    "name": "Prabhat Samgiita AI",
    "slug": "prabhat-samgiita-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prabhatai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.prabhatasamgiita.ai",
      "buildNumber": "1",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "net.prabhatasamgiita.ai",
      "versionCode": 1,
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Prabhat Samgiita AI to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow Prabhat Samgiita AI to turn speech into search text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000",
      "eas": {
        "projectId": "4a49bf45-0d4a-4362-bbcf-35851d255cc5"
      }
    }
  }
}
