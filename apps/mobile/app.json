{
  "expo": {
    "name": "Prabhat Samgiita AI",
    "owner": "dewasheesh3s-team",
    "slug": "prabhatsamgiitaai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prabhatai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.prabhatasamgiita.ai",
      "buildNumber": "21",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "net.prabhatasamgiita.ai",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-file-system",
      "expo-web-browser",
      "expo-av",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.495992354696-l5ddf29pefc5ke9f1t8osi9dch0qckrs"
        }
      ],
      "./plugins/withIosProjectRootFix",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Prabhat Samgiita AI to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow Prabhat Samgiita AI to turn speech into search text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://prabhatai-api.bluemeadow-9418d5fc.centralindia.azurecontainerapps.io",
      "eas": {
        "projectId": "7cbd8dae-da81-4236-a7c2-c9c707540afe"
      }
    }
  }
}
